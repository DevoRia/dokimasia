#!/usr/bin/env python3
"""dokimasia — run untrusted code in a disposable QEMU VM that you (or an agent) drive from the host.

The host never executes anything from the repo. The repo is copied into the VM on a
read-only ISO, commands go in over a private virtio-serial socket, and everything that
comes back is treated as plain text.
"""
import argparse
import base64
import fnmatch
import hashlib
import json
import os
import platform
import re
import shutil
import signal
import socket
import subprocess
import sys
import tarfile
import tempfile
import textwrap
import time
import uuid
from pathlib import Path

VERSION = "0.5.0"
HOME = Path(os.environ.get("DOKIMASIA_HOME", Path.home() / ".dokimasia"))
BASE = HOME / "base.qcow2"
SESSIONS = HOME / "sessions"
MARKER = re.compile(rb"\n?DKM[0-9a-f]{32}(:\d+|-S)\n")


def die(msg):
    sys.exit(f"dokimasia: {msg}")


def say(msg):
    print(f"▸ {msg}", file=sys.stderr, flush=True)


def safe(data):
    """Guest output is untrusted: drop terminal escape sequences and control chars."""
    text = data.decode("utf-8", "replace")
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07?", "", text)
    return "".join(c if c in "\n\t" or ord(c) >= 32 else "" for c in text)


# --- platform -----------------------------------------------------------------
ARCH = {"arm64": "arm64", "aarch64": "arm64", "x86_64": "amd64", "amd64": "amd64"}.get(platform.machine().lower())
IMAGE_URL = f"https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-{ARCH}.qcow2"


def qemu(cpus=2, memory="2G"):
    if not ARCH:
        die(f"unsupported CPU: {platform.machine()}")
    exe = "qemu-system-aarch64" if ARCH == "arm64" else "qemu-system-x86_64"
    path = shutil.which(exe) or die(f"{exe} not found (brew install qemu / apt install qemu-system)")
    system = platform.system()
    if system == "Darwin":
        accel, cpu = "hvf", "host"
    elif system == "Linux" and os.access("/dev/kvm", os.W_OK):
        accel, cpu = "kvm", "host"
    elif system == "Linux":
        say("no /dev/kvm access — falling back to slow emulation")
        accel, cpu = "tcg", "max"
    else:
        die(f"unsupported OS: {system} (on Windows use WSL2)")
    cmd = [path, "-M", "virt" if ARCH == "arm64" else "q35", "-accel", accel, "-cpu", cpu,
           "-smp", str(cpus), "-m", memory, "-display", "none", "-monitor", "none", "-no-reboot"]
    if ARCH == "arm64":
        share = Path(path).resolve().parent.parent / "share/qemu"
        for fw in [share / "edk2-aarch64-code.fd", Path("/usr/share/qemu/edk2-aarch64-code.fd"),
                   Path("/usr/share/AAVMF/AAVMF_CODE.fd"), Path("/usr/share/qemu-efi-aarch64/QEMU_EFI.fd")]:
            if fw.exists():
                cmd += ["-drive", f"if=pflash,format=raw,readonly=on,file={fw}"]
                break
        else:
            die("UEFI firmware for aarch64 not found (install qemu-efi-aarch64)")
    return cmd


def sandbox_prefix(session):
    """macOS: wrap the QEMU process in a sandbox so that even a VM escape can't read your home directory or reach
    services on the host's loopback (which `--net` would otherwise expose at 10.0.2.2)."""
    if platform.system() != "Darwin" or os.environ.get("DOKIMASIA_NO_SANDBOX") or not shutil.which("sandbox-exec"):
        return []
    q = lambda p: str(Path(p).resolve()).replace("\\", "\\\\").replace('"', '\\"')
    profile = f"""(version 1)
(allow default)
(deny file-read* file-write* (subpath "{q(Path.home())}"))
(allow file-read-metadata (subpath "{q(Path.home())}"))
(allow file-read* file-write* (subpath "{q(session)}"))
(allow file-read* (literal "{q(BASE)}"))
(deny network-outbound (remote ip "localhost:*"))
"""
    return ["sandbox-exec", "-p", profile]


def seed_iso(dirpath, iso, instance_id, user_data):
    """cloud-init NoCloud seed: a read-only ISO labelled "cidata"."""
    (dirpath / "meta-data").write_text(f"instance-id: {instance_id}\n")
    (dirpath / "user-data").write_text(user_data)
    for tool in (["hdiutil", "makehybrid", "-quiet", "-iso", "-joliet", "-default-volume-name", "cidata", "-o"],
                 ["xorriso", "-as", "mkisofs", "-quiet", "-V", "cidata", "-J", "-r", "-o"],
                 ["genisoimage", "-quiet", "-V", "cidata", "-J", "-r", "-o"]):
        if shutil.which(tool[0]):
            subprocess.run(tool + [str(iso), str(dirpath)], check=True)
            return
    die("need hdiutil, xorriso or genisoimage to build the seed ISO")


def drives(disk, iso):
    return ["-drive", f"if=virtio,format=qcow2,file={disk}",
            "-drive", f"if=virtio,format=raw,readonly=on,file={iso}"]


# --- init ---------------------------------------------------------------------
INIT_USER_DATA = """#cloud-config
package_update: true
packages: [nodejs, npm, python3-pip, python3-venv, git, make, build-essential, curl, strace]
runcmd:
  - [sh, -c, "command -v node && for t in /dev/ttyAMA0 /dev/ttyS0; do [ -c $t ] && timeout 5 sh -c \\"echo DOKIMASIA-READY > $t\\"; done"]
power_state: {mode: poweroff, condition: true}
"""


def verify_image(path):
    """Compare the downloaded image with Debian's published SHA512SUMS (same HTTPS origin: catches corruption and
    a tampered mirror/CDN object, not a compromised origin)."""
    sums_url = IMAGE_URL.rsplit("/", 1)[0] + "/SHA512SUMS"
    name = IMAGE_URL.rsplit("/", 1)[1]
    sums = subprocess.run(["curl", "-fsSL", sums_url], capture_output=True, text=True, check=True).stdout
    want = next((l.split()[0] for l in sums.splitlines() if l.split()[-1:] == [name]), None)
    check_sha512(path, want, name)


def check_sha512(path, want, name):
    if not want:
        die(f"{name} is not listed in SHA512SUMS, refusing to use the image")
    h = hashlib.sha512()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    if h.hexdigest() != want:
        die(f"checksum mismatch for {name} — the download is corrupt or tampered with, not using it")
    say("image checksum OK (sha512)")


def cmd_init(a=None):
    if BASE.exists() and not getattr(a, "force", False):
        return say(f"already initialized: {BASE} (dokimasia init --force rebuilds it)")
    HOME.mkdir(parents=True, exist_ok=True)
    base_cmd = qemu()
    with tempfile.TemporaryDirectory(dir=HOME) as tmp:
        tmp = Path(tmp)
        disk, seed, log = tmp / "disk.qcow2", tmp / "seed", tmp / "serial.log"
        say(f"downloading Debian 13 cloud image ({ARCH}, ~350 MB)…")
        subprocess.run(["curl", "-fL", "--progress-bar", "-o", str(disk), IMAGE_URL], check=True)
        verify_image(disk)
        subprocess.run(["qemu-img", "resize", "-q", str(disk), "8G"], check=True)
        seed.mkdir()
        seed_iso(seed, tmp / "seed.iso", "dokimasia-base", INIT_USER_DATA)
        say("installing toolchain inside the base VM (a few minutes)…")
        subprocess.run(base_cmd + drives(disk, tmp / "seed.iso") +
                       ["-nic", "user,model=virtio-net-pci", "-serial", f"file:{log}"], timeout=1200)
        if "DOKIMASIA-READY" not in log.read_text(errors="replace"):
            shutil.copy(log, HOME / "init-serial.log")
            die(f"base image setup failed, see {HOME / 'init-serial.log'}")
        disk.rename(BASE)
    say(f"ready: {BASE}")


ADD_USER_DATA = """#cloud-config
package_update: true
packages: [{packages}]
runcmd:
  - [sh, -c, "dpkg -s {names} >/dev/null && for t in /dev/ttyAMA0 /dev/ttyS0; do [ -c $t ] && timeout 5 sh -c \\"echo DOKIMASIA-READY > $t\\"; done"]
power_state: {{mode: poweroff, condition: true}}
"""


def cmd_add(a):
    """Install extra tools into the clean base image — online, before any untrusted code is loaded."""
    bad = [p for p in a.packages if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]*", p)]
    if bad:
        die(f"not a Debian package name: {' '.join(bad)}")
    running = [s.name for s in SESSIONS.glob("*") if alive(s)] if SESSIONS.exists() else []
    if running:
        die(f"stop running sessions first: {' '.join(running)}")
    if not BASE.exists():
        cmd_init()
    base_cmd = qemu()
    with tempfile.TemporaryDirectory(dir=HOME) as tmp:
        tmp = Path(tmp)
        overlay, seed, log = tmp / "overlay.qcow2", tmp / "seed", tmp / "serial.log"
        subprocess.run(["qemu-img", "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", str(BASE), str(overlay)],
                       check=True)
        seed.mkdir()
        seed_iso(seed, tmp / "seed.iso", f"add-{uuid.uuid4().hex}",
                 ADD_USER_DATA.format(packages=", ".join(a.packages), names=" ".join(a.packages)))
        say(f"installing {' '.join(a.packages)} into the base image…")
        subprocess.run(base_cmd + drives(overlay, tmp / "seed.iso") +
                       ["-nic", "user,model=virtio-net-pci", "-serial", f"file:{log}"], timeout=1800)
        if "DOKIMASIA-READY" not in log.read_text(errors="replace"):
            shutil.copy(log, HOME / "add-serial.log")
            die(f"install failed, base image unchanged — see {HOME / 'add-serial.log'}")
        subprocess.run(["qemu-img", "commit", "-q", str(overlay)], check=True)
    say(f"added to base image: {' '.join(a.packages)}")


# --- sessions -----------------------------------------------------------------
# The guest runs a root shell on a virtio-serial port. Nothing listens on the network.
SESSION_USER_DATA = """#cloud-config
runcmd:
  - [sh, -c, "mkdir -p /mnt/seed /work && mount -o ro -L cidata /mnt/seed && tar -xzf /mnt/seed/repo.tgz -C /work && umount /mnt/seed"]
  - [systemd-run, --unit=dokimasia-agent, sh, -c, "while :; do bash --noprofile --norc <> /dev/virtio-ports/dokimasia >&0 2>&0; sleep 0.2; done"]
"""


def session(name):
    return SESSIONS / name


def alive(s):
    try:
        os.kill(int((s / "qemu.pid").read_text()), 0)
        return True
    except (OSError, ValueError):
        return False


def fetch(target, dest):
    if "://" in target or target.startswith("git@"):
        say(f"cloning {target} (no hooks, no submodules)…")
        env = dict(os.environ, GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null", GIT_TERMINAL_PROMPT="0")
        subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false",
                        "-c", "protocol.file.allow=never", "clone", "-q", "--depth=1",
                        "--no-recurse-submodules", "--", target, str(dest)], env=env, check=True)
        return dest
    src = Path(target).expanduser()
    if not src.is_dir():
        die(f"not a directory: {src}")
    return src


# --- audit: read-only scan for things that run by themselves when a repo is opened or installed ---
AUTO_PATTERNS = re.compile(r"curl[^|]*\|\s*(ba|z)?sh|wget[^|]*\|\s*(ba|z)?sh|base64\s+(-d|--decode)|\beval\b|powershell[^\n]*-enc"
                           r"|/dev/tcp/|\bnc\b\s+-e", re.I)
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "__pycache__"}
NPM_AUTO = ("preinstall", "install", "postinstall", "prepare", "preprepare", "postprepare", "prepack")
DEV_HOST = ("initializeCommand",)
DEV_BOX = ("onCreateCommand", "updateContentCommand", "postCreateCommand", "postStartCommand", "postAttachCommand")
EDITORS = {"VS Code": ("Code", ".config/Code"), "Cursor": ("Cursor", ".config/Cursor")}


def jsonc(text):
    out, i, n, in_str = [], 0, len(text), False
    text = text.lstrip("\ufeff")
    n = len(text)
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(c)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))


def load_json(path):
    try:
        if path.is_symlink() or path.stat().st_size > 1_000_000:
            return None
        return json.loads(jsonc(path.read_text(errors="replace")))
    except (OSError, ValueError):
        return None


def cmdtext(v):
    if isinstance(v, str):
        return v
    if isinstance(v, list):
        return " ".join(cmdtext(x) for x in v)
    if isinstance(v, dict):
        return " ".join(cmdtext(x) for x in v.values())
    return ""


def scan(root):
    """Return [(level, file, message)]. Only reads files; never runs or imports anything from the repo."""
    root = Path(root)
    found = []

    def add(level, rel, msg, cmd=""):
        clean = lambda t: " ".join(safe(t.encode("utf-8", "replace")).split())  # repo text is untrusted
        cmd, msg, rel = clean(cmd), clean(msg), clean(rel)
        if cmd and AUTO_PATTERNS.search(cmd):
            level, msg = "HIGH", msg + " [suspicious pattern]"
        found.append((level, rel, msg + (f": {cmd[:140]}" if cmd else "")))

    tasks = load_json(root / ".vscode/tasks.json")
    if isinstance(tasks, dict) and isinstance(tasks.get("tasks"), list):
        for t in tasks["tasks"]:
            ro = t.get("runOptions") if isinstance(t, dict) else None
            if isinstance(ro, dict) and ro.get("runOn") == "folderOpen":
                add("HIGH", ".vscode/tasks.json", f'task "{t.get("label", "?")}" runs when the folder is opened',
                    cmdtext(t.get("command")) + " " + cmdtext(t.get("args")))
    ws = load_json(root / ".vscode/settings.json")
    if isinstance(ws, dict):
        if ws.get("task.allowAutomaticTasks") == "on":
            add("HIGH", ".vscode/settings.json", "turns automatic tasks on")
        if ws.get("security.workspace.trust.enabled") is False:
            add("HIGH", ".vscode/settings.json", "turns Workspace Trust off")
    dev = [root / ".devcontainer.json", root / ".devcontainer/devcontainer.json"]
    dev += sorted((root / ".devcontainer").glob("*/devcontainer.json")) if (root / ".devcontainer").is_dir() else []
    for d in dev:
        j = load_json(d)
        if isinstance(j, dict):
            rel = str(d.relative_to(root))
            for k in DEV_HOST:
                if k in j:
                    add("HIGH", rel, f"{k} runs on your host, not in the container", cmdtext(j[k]))
            for k in DEV_BOX:
                if k in j:
                    add("WARN", rel, f"{k} runs when the container is built/started", cmdtext(j[k]))
    for cfg, key, what in ((".claude/settings.json", "hooks", "Claude Code hooks run shell commands"),
                           (".claude/settings.local.json", "hooks", "Claude Code hooks run shell commands"),
                           (".mcp.json", "mcpServers", "MCP servers are launched as commands"),
                           (".cursor/mcp.json", "mcpServers", "MCP servers are launched as commands"),
                           (".vscode/mcp.json", "servers", "MCP servers are launched as commands")):
        j = load_json(root / cfg)
        if isinstance(j, dict) and j.get(key):
            add("HIGH" if key == "hooks" else "WARN", cfg, what, cmdtext(j[key]))
        if isinstance(j, dict) and j.get("enableAllProjectMcpServers") is True:
            add("HIGH", cfg, "auto-approves every project MCP server")
    seen = 0
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        rel_dir = Path(dirpath).relative_to(root)
        if len(rel_dir.parts) > 3:
            dirs[:] = []
        for name in files + dirs:
            seen += 1
            full = Path(dirpath) / name
            rel = str(rel_dir / name) if str(rel_dir) != "." else name
            if full.is_symlink():
                tgt = os.path.realpath(full)
                if not (tgt == str(root.resolve()) or tgt.startswith(str(root.resolve()) + os.sep)):
                    add("WARN", rel, f"symlink points outside the repo -> {os.readlink(full)}")
            elif name == "package.json" and full.is_file():
                j = load_json(full)
                sc = j.get("scripts") if isinstance(j, dict) else None
                for k in (NPM_AUTO if isinstance(sc, dict) else ()):
                    if k in sc:
                        add("WARN", rel, f'npm "{k}" script runs on install', cmdtext(sc[k]))
            elif name == "setup.py" and full.is_file():
                add("WARN", rel, "runs arbitrary Python on pip install")
        if seen > 20000:
            break
    for d in (".husky", ".githooks"):
        if (root / d).is_dir():
            add("WARN", d, "git hooks (run after install or if hooksPath is set)")
    for f in ("CLAUDE.md", "AGENTS.md", ".cursorrules", ".github/copilot-instructions.md"):
        if (root / f).is_file():
            add("INFO", f, "agent instructions: treat as untrusted text, may contain prompt injection")
    return found


def editor_report():
    lines = []
    for name, (mac, linux) in EDITORS.items():
        for path in (Path.home() / "Library/Application Support" / mac / "User/settings.json",
                     Path.home() / linux / "User/settings.json"):
            if path.is_file():
                j = load_json(path) or {}
                auto = j.get("task.allowAutomaticTasks", "not set (default)")
                trust = j.get("security.workspace.trust.enabled", "not set (default)")
                lines.append(f'  {name}: task.allowAutomaticTasks = {auto}, workspace trust = {trust}')
                if auto != "off":
                    lines.append(f'         tip: add "task.allowAutomaticTasks": "off" to {path}')
                break
    return lines


def report(root, label):
    found = scan(root)
    order = {"HIGH": 0, "WARN": 1, "INFO": 2}
    print(f"audit {label}  (read-only, nothing from the repo is executed)")
    for lvl, rel, msg in sorted(found, key=lambda x: order[x[0]]):
        print(f"  {lvl:<4}  {rel}  {msg}")
    n = {k: sum(1 for f in found if f[0] == k) for k in order}
    print(f"{n['HIGH']} high, {n['WARN']} warn, {n['INFO']} info" if found else "nothing here runs by itself that I can see")
    if n["HIGH"]:
        print("do NOT open this folder in an editor on your host; use `dokimasia up` and read it through exec")
    ed = editor_report()
    if ed:
        print("your editor:")
        print("\n".join(ed))
    return n["HIGH"]


def install_hook(repo):
    hooks = Path(repo) / ".git/hooks"
    if not hooks.is_dir():
        die(f"{repo} is not a git checkout")
    for name in ("post-merge", "post-checkout"):
        hook = hooks / name
        if hook.exists():
            die(f"{hook} already exists, not overwriting")
    for name in ("post-merge", "post-checkout"):
        hook = hooks / name
        hook.write_text('#!/bin/sh\n# dokimasia: read-only scan after pull/checkout\ndokimasia audit . >&2 || true\n')
        hook.chmod(0o755)
    say("installed post-merge and post-checkout hooks: `git pull` now runs `dokimasia audit .`")


def cmd_audit(a):
    if a.install_hook:
        return install_hook(a.target)
    tmp = None
    try:
        if "://" in a.target or a.target.startswith("git@"):
            tmp = Path(tempfile.mkdtemp(prefix="dokimasia-audit-"))
            src = fetch(a.target, tmp / "src")
        else:
            src = fetch(a.target, None)
        high = report(src, a.target)
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    sys.exit(2 if high else 0)


SECRET_GLOBS = (".env", ".env.*", "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", "*.pem", "*.key", "*.p12", "*.pfx",
                ".npmrc", ".pypirc", ".netrc", ".git-credentials", "credentials.json", "*.kdbx", ".aws", ".ssh", ".gnupg")
SECRET_OK = (".env.example", ".env.sample", ".env.template", ".env.dist")


def looks_secret(arcname):
    base = Path(arcname).name
    return base not in SECRET_OK and any(fnmatch.fnmatch(base, g) for g in SECRET_GLOBS)


def cmd_up(a):
    s = session(a.name)
    if alive(s):
        die(f"session '{a.name}' is already running (dokimasia down --name {a.name})")
    if not BASE.exists():
        cmd_init()
    base_cmd = qemu(a.cpus, a.memory)
    shutil.rmtree(s, ignore_errors=True)
    (s / "seed").mkdir(parents=True)
    os.chmod(s, 0o700)

    local = not ("://" in a.target or a.target.startswith("git@"))
    src = fetch(a.target, s / "src")
    risky = [f for f in scan(src) if f[0] in ("HIGH", "WARN")]
    if risky:
        say(f"audit: {len(risky)} auto-run item(s) in this repo ({sum(1 for f in risky if f[0] == 'HIGH')} high) — "
            f"see `dokimasia audit {a.target}`; don't open it in an editor on your host")
    # Symlinks are archived as links, never followed, so a link to ~/.ssh stays a dangling link.
    skipped = []

    def keep(info):
        if local and not a.keep_secrets and looks_secret(info.name):
            skipped.append(info.name)
            return None
        return info

    with tarfile.open(s / "seed/repo.tgz", "w:gz") as tar:
        tar.add(src, arcname=".", filter=keep)
    if skipped:
        say(f"left out {len(skipped)} secret-looking file(s) from the copy (e.g. {skipped[0]}); --keep-secrets to include")
    shutil.rmtree(s / "src", ignore_errors=True)
    seed_iso(s / "seed", s / "seed.iso", f"session-{uuid.uuid4().hex}", SESSION_USER_DATA)
    subprocess.run(["qemu-img", "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", str(BASE), str(s / "disk.qcow2"),
                    a.disk], check=True)  # the guest grows its root partition to fit on boot

    nic = ["-nic", "user,model=virtio-net-pci"] if a.net else ["-nic", "none"]
    subprocess.run(sandbox_prefix(s) + base_cmd + drives(s / "disk.qcow2", s / "seed.iso") + nic + [
        "-device", "virtio-serial-pci",
        "-chardev", f"socket,id=ctl,path={s / 'ctl.sock'},server=on,wait=off",
        "-device", "virtserialport,chardev=ctl,name=dokimasia",
        "-serial", f"file:{s / 'console.log'}",
        "-daemonize", "-pidfile", str(s / "qemu.pid")], check=True)
    (s / "network").write_text("on" if a.net else "off")

    say(f"booting '{a.name}' ({a.cpus} CPU, {a.memory} RAM, {a.disk} disk, network: {'ON' if a.net else 'off'})…")
    deadline = time.time() + 240
    while time.time() < deadline:
        try:
            if guest_exec(s, "true", timeout=3, echo=False) == 0:
                return say(f"ready — dokimasia exec{name_flag(a.name)} -- <cmd>")
        except OSError:
            pass
        time.sleep(1)
    die(f"VM did not become ready, see {s / 'console.log'}")


def name_flag(name):
    return "" if name == "default" else f" --name {name}"


def guest_exec(s, script, timeout, echo=True):
    """Send a script to the guest shell, stream its output, return its exit code (124 on timeout)."""
    m = "DKM" + uuid.uuid4().hex
    payload = "\n".join(textwrap.wrap(base64.b64encode(f"cd /work\n{script}\n".encode()).decode(), 76))
    request = (f"base64 -d > /tmp/{m} <<'{m}'\n{payload}\n{m}\n"
               f"printf '\\n{m}-S\\n'; bash --noprofile --norc /tmp/{m} </dev/null 2>&1; r=$?; rm -f /tmp/{m}; printf '\\n{m}:%s\\n' $r\n")
    start = f"\n{m}-S\n".encode()  # anything before it is leftover output of an earlier command
    done = re.compile(rb"\n" + m.encode() + rb":(\d+)\n")

    def emit(chunk):
        if echo and chunk:
            sys.stdout.write(safe(MARKER.sub(b"", chunk)))
            sys.stdout.flush()

    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(5)
        sock.connect(str(s / "ctl.sock"))
        sock.sendall(request.encode())
        buf, shown, started, deadline = b"", 0, False, time.time() + timeout
        while time.time() < deadline:
            sock.settimeout(max(0.1, min(1.0, deadline - time.time())))
            try:
                data = sock.recv(65536)
            except socket.timeout:
                continue
            if not data:
                break
            buf += data
            if not started:
                if start not in buf:
                    continue
                buf, started = buf.split(start, 1)[1], True
            hit = done.search(buf)
            if hit:
                emit(buf[shown:hit.start()])
                return int(hit[1])
            keep = max(shown, len(buf) - len(m) - 16)  # hold back a possibly split marker
            emit(buf[shown:keep])
            shown = keep
    if started:
        emit(buf[shown:])
    return 124


def running(name):
    s = session(name)
    if not alive(s):
        die(f"no running session '{name}' (dokimasia up <repo>{name_flag(name)})")
    return s


def cmd_exec(a):
    cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
    if not cmd:
        die("usage: dokimasia exec -- <cmd...>")
    script = cmd[0] if len(cmd) == 1 else " ".join(_quote(c) for c in cmd)
    code = guest_exec(running(a.name), script, a.timeout)
    if code == 124:
        say(f"timed out after {a.timeout}s — the command may still be running in the VM")
    sys.exit(code)


def _quote(arg):
    return arg if re.fullmatch(r"[\w@%+=:,./-]+", arg) else "'" + arg.replace("'", "'\\''") + "'"


def cmd_logs(a):
    log = running(a.name) / "console.log"
    lines = safe(log.read_bytes()).splitlines()
    print("\n".join(lines[-a.lines:]))


def cmd_down(a):
    s = session(a.name)
    if alive(s):
        pid = int((s / "qemu.pid").read_text())
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not alive(s):
                break
            time.sleep(0.1)
        else:
            os.kill(pid, signal.SIGKILL)
    shutil.rmtree(s, ignore_errors=True)
    say(f"'{a.name}' destroyed")


def cmd_ls(_):
    for s in sorted(SESSIONS.glob("*")) if SESSIONS.exists() else []:
        net = (s / "network").read_text() if (s / "network").exists() else "?"
        print(f"{s.name}\t{'running' if alive(s) else 'stopped'}\tnetwork:{net}")


def cmd_run(a):
    a.name = f"run-{uuid.uuid4().hex[:6]}"
    try:
        cmd_up(a)
        cmd_exec(a)
    finally:
        cmd_down(a)


def main():
    p = argparse.ArgumentParser(prog="dokimasia", description="Run untrusted code in a disposable QEMU VM.")
    p.add_argument("-v", "--version", action="version", version=f"dokimasia {VERSION}")
    sub = p.add_subparsers(dest="action", required=True)

    init = sub.add_parser("init", help="download + prepare the base VM image (once)")
    init.add_argument("--force", action="store_true", help="rebuild the base image")
    init.set_defaults(fn=cmd_init)

    add = sub.add_parser("add", help="install apt packages into the base image (online, before any repo is loaded)")
    add.add_argument("packages", nargs="+", metavar="package")
    add.set_defaults(fn=cmd_add)

    def with_vm(sp):
        sp.add_argument("target")
        sp.add_argument("--net", action="store_true", help="give the VM outbound network (default: no network device)")
        sp.add_argument("--cpus", type=int, default=2)
        sp.add_argument("--memory", default="2G", help="RAM, e.g. 8G (default: 2G)")
        sp.add_argument("--disk", default="16G", help="disk size, e.g. 40G (default: 16G)")
        sp.add_argument("--keep-secrets", action="store_true",
                        help="also copy .env, keys and tokens from a local directory (default: they are left out)")
        return sp

    def with_name(sp):
        sp.add_argument("--name", default="default", help="session name (default: default)")
        return sp

    with_vm(with_name(sub.add_parser("up", help="boot a VM with a copy of <dir|git-url> in /work"))).set_defaults(fn=cmd_up)

    ex = with_name(sub.add_parser("exec", help="run a command inside the VM (cwd /work)"))
    ex.add_argument("--timeout", type=int, default=600)
    ex.add_argument("cmd", nargs=argparse.REMAINDER)
    ex.set_defaults(fn=cmd_exec)

    run = with_vm(sub.add_parser("run", help="up + exec + down in one go"))
    run.add_argument("--timeout", type=int, default=600)
    run.add_argument("cmd", nargs=argparse.REMAINDER)
    run.set_defaults(fn=cmd_run)

    lg = with_name(sub.add_parser("logs", help="show the VM serial console"))
    lg.add_argument("-n", "--lines", type=int, default=50)
    lg.set_defaults(fn=cmd_logs)

    with_name(sub.add_parser("down", help="kill the VM and delete its disk")).set_defaults(fn=cmd_down)
    sub.add_parser("ls", help="list sessions").set_defaults(fn=cmd_ls)

    au = sub.add_parser("audit", help="read-only scan of <dir|git-url> for things that run on open/install (exit 2 if high-risk)")
    au.add_argument("target")
    au.add_argument("--install-hook", action="store_true", help="make `git pull`/checkout in the repo <target> run this scan")
    au.set_defaults(fn=cmd_audit)

    a = p.parse_args()
    try:
        a.fn(a)
    except subprocess.CalledProcessError as e:
        die(f"{Path(e.cmd[0]).name} failed (exit {e.returncode})")


if __name__ == "__main__":
    main()
